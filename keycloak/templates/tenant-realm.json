  "roles": {
    "realm": [
      {
        "name": "tenant-admin",
        "description": "Vai chính quản trị viên của tenant (ánh xạ từ vai admin trong hợp đồng)",
        "composite": false
      },
      {
        "name": "tenant-teacher",
